# Frontend service: exports the Reflex frontend as static files and serves them
# with Caddy, which also proxies backend routes to the Backend service over
# Railway's private network. This is the only service with a public domain.
FROM python:3.13-slim AS builder

# uv installs python packages; Reflex uses the bun on PATH to build the frontend.
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /bin/uv
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun
ENV UV_COMPILE_BYTECODE=1 UV_NO_CACHE=1 PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY requirements.txt .
RUN uv venv && uv pip install -r requirements.txt

COPY . .
# The frontend talks to the backend on its own origin (Caddy proxies it), so no
# REFLEX_API_URL is needed at build time.
RUN reflex export --frontend-only --no-zip


FROM caddy:2-alpine

COPY --from=builder /app/.web/build/client /srv
COPY Caddyfile /etc/caddy/Caddyfile
